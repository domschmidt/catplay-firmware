Subject: [PATCH] cdc-ncm: use conservative transport settings for VAG CarPlay

Match only the VAG 1a96:201a NCM interface. Bound NTBs to 12288/15224 bytes,
retain the default MTU, and settle 220 ms before activating the data altsetting.
Retain the existing CarPlay link and packet-filter quirks.

--- a/drivers/net/usb/cdc_ncm.c
+++ b/drivers/net/usb/cdc_ncm.c
@@ -66,6 +66,7 @@
 static void cdc_ncm_tx_timeout_start(struct cdc_ncm_ctx *ctx);
 static enum hrtimer_restart cdc_ncm_tx_timer_cb(struct hrtimer *hr_timer);
 static struct usb_driver cdc_ncm_driver;
+static const struct driver_info carplay_vag_info;
 
 struct cdc_ncm_stats {
 	char stat_string[ETH_GSTRING_LEN];
@@ -718,6 +719,13 @@
 			le32_to_cpu(ctx->ncm_parm.dwNtbOutMaxSize));
 	}
 
+	/* Conservative bounds for the VAG iAP2 NCM accessory. */
+	if (dev->driver_info == &carplay_vag_info) {
+		def_rx = min_t(u32, 12288, le32_to_cpu(ctx->ncm_parm.dwNtbInMaxSize));
+		def_tx = min_t(u32, 15224, le32_to_cpu(ctx->ncm_parm.dwNtbOutMaxSize));
+		dev_info(&dev->intf->dev, "CarPlay VAG NCM profile: rx=%u tx=%u settle=220ms\n", def_rx, def_tx);
+	}
+
 	/* clamp rx_max and tx_max and inform device */
 	cdc_ncm_update_rxtx_max(dev, def_rx, def_tx);
 
@@ -933,7 +941,10 @@
 	 * empirically on a Sierra Wireless MC7455 running 02.08.02.00
 	 * firmware.
 	 */
-	usleep_range(10000, 20000);
+	if (dev->driver_info == &carplay_vag_info)
+		msleep(220);
+	else
+		usleep_range(10000, 20000);
 
 	/* configure data interface */
 	temp = usb_set_interface(dev->udev, iface_no, data_altsetting);
@@ -1965,6 +1976,19 @@
 	    .set_rx_mode = cdc_ncm_update_filter,
 };
 
+static const struct driver_info carplay_vag_info = {
+	.description = "VAG CarPlay Headunit (conservative NCM)",
+	.flags = FLAG_POINTTOPOINT | FLAG_NO_SETINT | FLAG_MULTI_PACKET
+			| FLAG_ETHER | FLAG_SEND_ZLP | CDC_NCM_FLAG_CARPLAY_MATCH_FILTER | CDC_NCM_FLAG_CARPLAY_ALWAYS_UP,
+	    .bind = cdc_ncm_bind,
+	    .unbind = cdc_ncm_unbind,
+	    .manage_power = usbnet_manage_power,
+	    .status = cdc_ncm_status,
+	    .rx_fixup = cdc_ncm_rx_fixup,
+	    .tx_fixup = cdc_ncm_tx_fixup,
+	    .set_rx_mode = cdc_ncm_update_filter,
+};
+
 static const struct driver_info cdc_ncm_info = {
 	.description = "CDC NCM (NO ZLP)",
 	.flags = FLAG_POINTTOPOINT | FLAG_NO_SETINT | FLAG_MULTI_PACKET
@@ -2167,6 +2191,12 @@
 	  .driver_info = (unsigned long)&cdc_ncm_zlp_info,
 	},
 
+	/* VAG iAP2 NCM accessory; preserve existing behavior for all other devices. */
+	{ USB_DEVICE_AND_INTERFACE_INFO(0x1a96, 0x201a, USB_CLASS_COMM,
+		USB_CDC_SUBCLASS_NCM, USB_CDC_PROTO_NONE),
+		.driver_info = (unsigned long)&carplay_vag_info,
+	},
+
 	/* Generic CDC-NCM devices */
 	{ USB_INTERFACE_INFO(USB_CLASS_COMM,
 		USB_CDC_SUBCLASS_NCM, USB_CDC_PROTO_NONE),
